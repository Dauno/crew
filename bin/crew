#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: crew claude|codex|pi [args]\n' >&2
}

if (($# == 0)); then
  usage
  exit 2
fi

cli_name=$1
shift
case "$cli_name" in
  claude | codex | pi) ;;
  *)
    usage
    exit 2
    ;;
esac

# Clear tool-session markers while preserving provider configuration.
unset CLAUDECODE CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_ENTRYPOINT \
  CLAUDE_CODE_EXECPATH CLAUDE_CODE_MESSAGING_SOCKET \
  CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_SESSION_ATTENDED \
  CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SSE_PORT CLAUDE_PID \
  CODEX_CI CODEX_SANDBOX CODEX_SANDBOX_NETWORK_DISABLED \
  CODEX_SESSION_ID CODEX_THREAD_ID

source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export PATH="$source_root/bin:$PATH"
if command -v realpath >/dev/null 2>&1; then
  default_crew_bin=$(realpath -- "${BASH_SOURCE[0]}")
else
  default_crew_bin=$source_root/bin/crew
fi
CREW_BIN=${CREW_BIN:-$default_crew_bin}
default_core_instructions=$source_root/core/instructions.md
CREW_CORE_INSTRUCTIONS=${CREW_CORE_INSTRUCTIONS:-$default_core_instructions}
CREW_SKILLS=${CREW_SKILLS:-$source_root/skills}
CREW_PLUGIN=${CREW_PLUGIN:-$source_root/claude}
CREW_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/crew
CREW_MEMORY=$CREW_HOME/memory
CREW_RUNS=$CREW_HOME/runs
if [[ ${CREW_SESSION_PREALLOCATED:-} != 1 ]]; then
  unset CREW_SESSION_PREALLOCATED
  CREW_SESSION_ID=$(python3 -c 'import uuid; print(uuid.uuid4())')
fi
[[ ${CREW_SESSION_ID:-} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
  printf 'crew: invalid CREW_SESSION_ID.\n' >&2
  exit 2
}
CREW_INBOX=$CREW_HOME/mailboxes/$CREW_SESSION_ID
export CREW_BIN CREW_CORE_INSTRUCTIONS CREW_SKILLS CREW_PLUGIN
export CREW_HOME CREW_MEMORY CREW_RUNS CREW_SESSION_ID CREW_INBOX

if [[ -z ${KITTY_LISTEN_ON:-} ]] || ! kitten @ ls >/dev/null 2>&1; then
  if [[ ${CREW_SESSION_PREALLOCATED:-} != 1 ]]; then
    CREW_SESSION_PREALLOCATED=1
    export CREW_SESSION_PREALLOCATED
    python3 "$CREW_SKILLS/nodes/scripts/mailbox.py" reserve \
      --cli "$cli_name" --node "${CREW_NODE:-}" --task "${CREW_TASK:-}" \
      --parent "${CREW_PARENT:-}" --started-at "${CREW_STARTED_AT:-}" \
      >/dev/null
  fi
  temp_dir=${TMPDIR:-/tmp}
  socket_path="$temp_dir/crew-${UID:-0}-$$-${RANDOM}-${RANDOM}.sock"
  while [[ -e $socket_path ]]; do
    socket_path="$temp_dir/crew-${UID:-0}-$$-${RANDOM}-${RANDOM}.sock"
  done
  kitty --detach \
    -o allow_remote_control=socket-only \
    -o macos_quit_when_last_window_closed=yes \
    --listen-on "unix:$socket_path" \
    --directory "$PWD" \
    "$CREW_BIN" "$cli_name" "$@"
  exit $?
fi

export CREW_CLI=$cli_name

codex_non_tui_command() {
  local index=0 argument command=''
  while (( index < ${#cli_args[@]} )); do
    argument=${cli_args[index]}
    case $argument in
      --config|-c|--enable|--disable|--remote|--remote-auth-token-env|\
      -i|--image|-m|--model|--local-provider|-p|--profile|-C|--cd|\
      --add-dir|-a|--ask-for-approval|-s|--sandbox)
        ((index += 2))
        ;;
      --config=*|--enable=*|--disable=*|--remote=*|\
      --remote-auth-token-env=*|--image=*|--model=*|--local-provider=*|\
      --profile=*|--cd=*|--add-dir=*|--ask-for-approval=*|--sandbox=*)
        ((index += 1))
        ;;
      --help|-h|--version|-V)
        return 0
        ;;
      --)
        return 1
        ;;
      -*)
        ((index += 1))
        ;;
      *)
        command=$argument
        break
        ;;
    esac
  done
  case $command in
    agents|exec|e|review|login|logout|mcp|plugin|app-server|\
    remote-control|completion|update|doctor|sandbox|debug|apply|a|queue|\
    archive|delete|migrate-rollouts|unarchive|exec-server|features|help)
      return 0
      ;;
    cloud)
      case ${cli_args[index+1]:-} in
        exec|status) return 0 ;;
      esac
      ;;
  esac
  return 1
}

native_receiver=0
cli_args=("$@")
if [[ -t 0 && -t 1 ]]; then
  native_receiver=1
  case $cli_name in
    claude)
      for arg in "${cli_args[@]}"; do
        [[ $arg == --print || $arg == -p ]] && native_receiver=0
      done
      ;;
    codex)
      if codex_non_tui_command; then
        native_receiver=0
      fi
      ;;
    pi)
      for ((index=0; index < ${#cli_args[@]}; index++)); do
        arg=${cli_args[index]}
        [[ $arg == --print || $arg == -p || $arg == --mode=json ||
          $arg == --mode=rpc ]] && native_receiver=0
        if [[ $arg == --mode ]] && (( index + 1 < ${#cli_args[@]} )); then
          [[ ${cli_args[index+1]} == json || ${cli_args[index+1]} == rpc ]] &&
            native_receiver=0
        fi
      done
      ;;
  esac
fi
if [[ ! ${KITTY_WINDOW_ID:-} =~ ^[1-9][0-9]*$ ]]; then
  native_receiver=0
fi
owns_kitty_route=0
if [[ ${CREW_SESSION_PREALLOCATED:-} == 1 || $native_receiver == 1 ]]; then
  owns_kitty_route=1
fi

repo_id() {
  local origin
  if ! origin=$(git remote get-url origin 2>/dev/null); then
    printf 'local/%s\n' "$(basename -- "$PWD" | tr '[:upper:]' '[:lower:]')"
    return
  fi

  python3 - "$origin" "$PWD" <<'PY'
import os
import re
import sys
from urllib.parse import unquote, urlsplit

origin, workdir = sys.argv[1:]
host = ""
path = ""
if origin.startswith(("git@", "hg@")) or re.match(
    r"^[^/@]+@[^:]+:", origin
):
    match = re.match(r"^(?:[^@]+@)?([^:]+):(.+)$", origin)
    if match:
        host, path = match.groups()
else:
    parsed = urlsplit(origin)
    if parsed.scheme and parsed.hostname:
        host, path = parsed.hostname, parsed.path
    elif ":" in origin:
        host, path = origin.split(":", 1)

path = unquote(path)
path = path.split("?", 1)[0].split("#", 1)[0].strip("/")
if path.endswith(".git"):
    path = path[:-4]
if host and path:
    print(f"{host}/{path}".lower())
else:
    name = os.path.basename(os.path.normpath(workdir)).lower() or "root"
    print(f"local/{name}")
PY
}

CREW_REPO_ID=$(repo_id)
export CREW_REPO_ID
repo_memory=$CREW_MEMORY/repos/
repo_memory+=${CREW_REPO_ID//\//_}

umask 077
mkdir -p "$CREW_HOME" "$CREW_MEMORY/global" "$CREW_MEMORY/machine" \
  "$CREW_MEMORY/repos" "$repo_memory" "$CREW_RUNS" \
  "$CREW_HOME/mailboxes"
chmod 700 "$CREW_HOME" "$CREW_MEMORY" "$CREW_MEMORY/global" \
  "$CREW_MEMORY/machine" "$CREW_MEMORY/repos" "$repo_memory" \
  "$CREW_RUNS" "$CREW_HOME/mailboxes"

create_index() {
  local path=$1
  local title=$2
  if [[ ! -e $path ]]; then
    printf '# %s\n' "$title" > "$path"
  fi
}

create_index "$CREW_MEMORY/index.md" 'Crew memory'
create_index "$CREW_MEMORY/global/index.md" 'Global memory'
create_index "$CREW_MEMORY/machine/index.md" 'Machine memory'
create_index "$CREW_MEMORY/repos/index.md" 'Repository memory'
create_index "$repo_memory/index.md" 'Repository memory'
mailbox_init=(
  python3 "$CREW_SKILLS/nodes/scripts/mailbox.py" init
  --cli "$cli_name" --node "${CREW_NODE:-}" --task "${CREW_TASK:-}"
  --parent "${CREW_PARENT:-}" --window "${KITTY_WINDOW_ID:-}"
  --started-at "${CREW_STARTED_AT:-}" --native "$native_receiver"
)
if [[ ${CREW_SESSION_PREALLOCATED:-} == 1 ]]; then
  mailbox_init+=(--consume-reservation)
fi
"${mailbox_init[@]}" >/dev/null
unset CREW_SESSION_PREALLOCATED
if [[ $owns_kitty_route == 1 && ${KITTY_WINDOW_ID:-} =~ ^[1-9][0-9]*$ ]]; then
  kitten @ set-user-vars --match "id:$KITTY_WINDOW_ID" \
    "crew_session=$CREW_SESSION_ID" "crew_cli=$cli_name" \
    "crew_native=$native_receiver"
fi

if [[ ! -f $CREW_CORE_INSTRUCTIONS ]]; then
  printf 'crew: missing core instructions: %s\n' \
    "$CREW_CORE_INSTRUCTIONS" >&2
  exit 1
fi

instructions_file=$(mktemp "${TMPDIR:-/tmp}/crew-instructions.XXXXXX")
codex_server_pid=''
codex_receiver_pid=''
codex_socket_dir=''
cleanup() {
  local status=$?
  trap - EXIT
  if [[ -n $codex_receiver_pid ]]; then
    kill "$codex_receiver_pid" 2>/dev/null || true
    wait "$codex_receiver_pid" 2>/dev/null || true
  fi
  if [[ -n $codex_server_pid ]]; then
    kill "$codex_server_pid" 2>/dev/null || true
    wait "$codex_server_pid" 2>/dev/null || true
  fi
  if [[ -n $codex_socket_dir ]]; then
    rm -rf -- "$codex_socket_dir"
  fi
  if [[ $owns_kitty_route == 1 &&
    ${KITTY_WINDOW_ID:-} =~ ^[1-9][0-9]*$ ]]; then
    kitten @ set-user-vars --match "id:$KITTY_WINDOW_ID" \
      crew_session= crew_cli= crew_native=0 >/dev/null 2>&1 || true
  fi
  rm -f -- "$instructions_file"
  exit "$status"
}
trap cleanup EXIT
cat -- "$CREW_CORE_INSTRUCTIONS" > "$instructions_file"

session_value() {
  local name=$1
  if [[ -n ${!name:-} ]]; then
    printf '%s' "${!name}"
  else
    printf '(unset)'
  fi
}

cat >> "$instructions_file" <<EOF

## This session

- CLI: $CREW_CLI
- Role: $(session_value CREW_ROLE)
- Node: $(session_value CREW_NODE)
- Task: $(session_value CREW_TASK)
- Parent Kitty window: $(session_value CREW_PARENT)
- Repository ID: $CREW_REPO_ID
- Session ID: $CREW_SESSION_ID
- Mailbox: $CREW_INBOX
- Memory: $CREW_MEMORY
- Runs: $CREW_RUNS
- Skills: $CREW_SKILLS
- Skill files:
EOF
while IFS= read -r skill_file; do
  printf '  - %s\n' "$skill_file" >> "$instructions_file"
done < <(
  find "$CREW_SKILLS" -mindepth 2 -maxdepth 2 -type f \
    -name SKILL.md -print | sort
)
printf '%s\n' \
  "- Read relevant skills from the listed SKILL.md paths before acting." \
  "- Nodes helper: crew-nodes" \
  >> "$instructions_file"

if [[ $cli_name == claude ]]; then
  claude_args=(
    --append-system-prompt-file "$instructions_file"
    --plugin-dir "$CREW_PLUGIN"
  )
  settings=$(python3 - <<'PY'
import json
rule = "Bash(crew-nodes *)"
print(json.dumps({"permissions": {"allow": [rule]}}))
PY
)
  claude_args+=(--settings "$settings")
  if [[ ${CREW_ROLE:-} == worker ]]; then
    claude_args+=(--dangerously-skip-permissions)
  fi
  claude "${claude_args[@]}" "$@"
elif [[ $cli_name == codex ]]; then
  developer_instructions=$(python3 - "$instructions_file" <<'PY'
import json
import pathlib
import sys
print(json.dumps(pathlib.Path(sys.argv[1]).read_text()))
PY
)
  codex_args=(
    --config "developer_instructions=$developer_instructions"
    --sandbox danger-full-access
  )
  if [[ ${CREW_ROLE:-} == worker ]]; then
    codex_args+=(--dangerously-bypass-approvals-and-sandbox)
  fi
  if [[ $native_receiver == 1 ]]; then
    for arg in "${cli_args[@]}"; do
      case $arg in
        --remote|--remote=*|--no-daemon)
          printf 'crew: interactive Codex owns its app-server; remove %s.\n' \
            "$arg" >&2
          exit 2
          ;;
      esac
    done
    codex_socket_dir=$(mktemp -d "${TMPDIR:-/tmp}/crew-codex.XXXXXX")
    chmod 700 "$codex_socket_dir"
    codex_socket=$codex_socket_dir/app.sock
    (( ${#codex_socket} < 90 )) || {
      printf 'crew: TMPDIR path is too long for a Codex Unix socket.\n' >&2
      exit 1
    }
    codex_endpoint="unix://$codex_socket"
    codex app-server --listen "$codex_endpoint" \
      --config "developer_instructions=$developer_instructions" \
      >"$codex_socket_dir/app-server.log" 2>&1 &
    codex_server_pid=$!
    for _ in {1..100}; do
      [[ -S $codex_socket ]] && break
      kill -0 "$codex_server_pid" 2>/dev/null || {
        printf 'crew: Codex app-server exited during startup.\n' >&2
        exit 1
      }
      sleep 0.1
    done
    [[ -S $codex_socket ]] || {
      printf 'crew: Codex app-server socket did not become ready.\n' >&2
      exit 1
    }
    python3 "$CREW_SKILLS/nodes/scripts/mailbox.py" codex-set \
      --socket "$codex_socket" --stale no
    python3 "$CREW_SKILLS/nodes/scripts/codex_receiver.py" \
      --socket "$codex_socket" >>"$CREW_INBOX/codex-receiver.log" 2>&1 &
    codex_receiver_pid=$!
    for _ in {1..100}; do
      [[ -f $CREW_INBOX/.codex-receiver-ready ]] && break
      kill -0 "$codex_receiver_pid" 2>/dev/null || {
        printf 'crew: Codex mailbox receiver failed to start.\n' >&2
        exit 1
      }
      sleep 0.1
    done
    [[ -f $CREW_INBOX/.codex-receiver-ready ]] || {
      printf 'crew: Codex mailbox receiver did not become ready.\n' >&2
      exit 1
    }
    codex_args+=(--remote "$codex_endpoint")
  fi
  codex "${codex_args[@]}" "$@"
else
  pi_args=(
    --append-system-prompt "$instructions_file"
    --skill "$CREW_SKILLS"
  )
  add_pi_tools=1
  for arg in "$@"; do
    case $arg in
      --tools|--tools=*|-t|--no-tools|-nt|--no-builtin-tools|-nbt)
        add_pi_tools=0
        break
        ;;
    esac
  done
  if [[ $add_pi_tools == 1 ]]; then
    pi_args+=(--tools '+grep,+find,+ls')
  fi
  if [[ $native_receiver == 1 ]]; then
    pi_args+=(--extension "$CREW_SKILLS/nodes/extensions/crew-messages.ts")
  fi
  if [[ ${CREW_ROLE:-} == worker ]]; then
    pi_task=${CREW_TASK:-_untasked}
    [[ -n $pi_task && $pi_task != . && $pi_task != .. &&
      $pi_task != */* && $pi_task != *$'\n'* &&
      $pi_task != *$'\r'* ]] || {
      printf 'crew: invalid task path component for Pi worker.\n' >&2
      exit 2
    }
    [[ ${KITTY_WINDOW_ID:-} =~ ^[1-9][0-9]*$ ]] || {
      printf 'crew: Pi worker requires a numeric KITTY_WINDOW_ID.\n' >&2
      exit 2
    }
    [[ ${CREW_STARTED_AT:-} =~ ^[1-9][0-9]*$ ]] || {
      printf 'crew: Pi worker requires a numeric CREW_STARTED_AT.\n' >&2
      exit 2
    }
    pi_session_dir="$CREW_RUNS/$pi_task/pi/${KITTY_WINDOW_ID}-${CREW_STARTED_AT}"
    mkdir -p "$(dirname -- "$pi_session_dir")"
    if ! mkdir -- "$pi_session_dir"; then
      printf 'crew: Pi worker session directory already exists: %s\n' \
        "$pi_session_dir" >&2
      exit 1
    fi
    pi_args+=(--session-dir "$pi_session_dir")
  fi
  pi "${pi_args[@]}" "$@"
fi
